# Example Terraform variables file
# Copy this to terraform.tfvars and customize for your environment

# Basic Configuration
aws_region   = "us-east-1"
environment  = "dev"
project_name = "my-app"
owner        = "DevOps Team"
cost_center  = "Engineering"

# Network Configuration
vpc_cidr = "10.0.0.0/16"

# ECS Configuration - Right-sizing
ecs_cpu           = 512    # 256, 512, 1024, 2048, 4096
ecs_memory        = 1024   # Must be compatible with CPU
ecs_desired_count = 2      # Number of tasks to run
ecs_min_capacity  = 1      # Minimum for autoscaling
ecs_max_capacity  = 10     # Maximum for autoscaling

# Application Configuration
app_port           = 8080
health_check_path  = "/health"

# Security Configuration
enable_deletion_protection = true
enable_waf                = true
log_retention_days        = 30